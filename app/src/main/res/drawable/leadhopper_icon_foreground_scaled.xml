<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Keep the full-color foreground on the exact same 64dp geometry as the
         approved monochrome monoglyph so themed and unthemed launcher icons
         have matching scale, centering, safe-area behavior, and silhouette. -->
    <item
        android:width="64dp"
        android:height="64dp"
        android:gravity="center"
        android:drawable="@drawable/leadhopper_icon_foreground_art" />
</layer-list>
